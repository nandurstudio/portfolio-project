# Example environment (redacted values) — commit this file to the repo
# Copy to `.env` and fill in real secrets before deploying.

# Database Configuration (Laravel/shared)
DB_DATABASE=portfolio
DB_USERNAME=portfolio_user
DB_PASSWORD=change_this_portfolio_db_password

# MySQL Root Password
MYSQL_ROOT_PASSWORD=change_this_root_password

# n8n Configuration
N8N_HOST=n8n.nandurstudio.com
WEBHOOK_URL=https://n8n.nandurstudio.com/
N8N_USER=admin
N8N_PASSWORD=change_this_n8n_password

# n8n DB
N8N_DB_USER=n8n
N8N_DB_PASSWORD=change_this_n8n_db_password
N8N_DB_NAME=n8n

# Domain / misc
DOMAIN=nandurstudio.com
APP_URL=https://nandurstudio.com

# kkmrat (undangan)
KKMRAT_DB_USER=kkmrat_user
KKMRAT_DB_PASS=change_this_kkmrat_db_password
KKMRAT_DB_NAME=db_undangan_rat
KKMRAT_AES_KEY=change_this_hex_or_random_key
