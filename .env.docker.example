# Redacted environment template (.env.sample)
# Copy this file to `.env` and fill in real secrets before deploying.

# Database Configuration (Laravel/shared)
DB_DATABASE=portfolio
DB_USERNAME=portfolio_user
DB_PASSWORD=change_this_portfolio_db_password

# MySQL Root Password
MYSQL_ROOT_PASSWORD=change_this_root_password

# n8n Configuration
N8N_HOST=n8n.yourdomain.com
WEBHOOK_URL=https://n8n.yourdomain.com/
N8N_USER=admin
N8N_PASSWORD=change_this_n8n_password

# n8n DB
N8N_DB_USER=n8n
N8N_DB_PASSWORD=change_this_n8n_db_password
N8N_DB_NAME=n8n

# Domain / misc
DOMAIN=yourdomain.com
APP_URL=https://yourdomain.com

# kkmrat (undangan) — application-specific
KKMRAT_DB_USER=kkmrat_user
KKMRAT_DB_PASS=change_this_kkmrat_db_password
KKMRAT_DB_NAME=db_undangan_rat
KKMRAT_AES_KEY=change_this_hex_or_random_key

# FileBrowser admin credentials
FILEBROWSER_ADMIN_USER=admin
FILEBROWSER_ADMIN_PASS=change_this_filebrowser_password

# Qdrant Vector Database Configuration
QDRANT_API_KEY=change_this_qdrant_api_key
QDRANT_READ_ONLY_API_KEY=change_this_qdrant_read_only_key
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION_NAME=pkb_documents

# Koperasi Vote — application-specific (Laravel 10)
KOPERASI_DB_USER=koperasi_user
KOPERASI_DB_PASS=change_this_koperasi_db_password
KOPERASI_DB_NAME=db_koperasi
KOPERASI_JWT_SECRET=change_this_koperasi_jwt_secret
KOPERASI_ADMIN_TOKEN_LIFETIME=28800
KOPERASI_VOTING_TOKEN_LIFETIME=3600

# Mail Configuration (Brevo SMTP - 300 free emails/day with quota system)
MAIL_MAILER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=your_username@smtp-brevo.com
MAIL_PASSWORD=change_this_brevo_smtp_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=your_email@domain.com
MAIL_FROM_NAME="KKM Voting Admin"
MAIL_OTP_DAILY_QUOTA=300

# Node-RED Configuration
NODERED_ADMIN_USER=admin
NODERED_ADMIN_PASSWORD=change_this_nodered_admin_password
NODERED_ADMIN_PASSWORD_HASH=change_this_nodered_admin_password_hash
NODERED_CREDENTIAL_SECRET=change_this_nodered_credential_secret

NODERED_USER_BASIC_AUTH_USER=user
NODERED_USER_PASSWORD=change_this_nodered_user_password
NODERED_USER_PASSWORD_HASH=change_this_nodered_user_password_hash
NODERED_USER_CREDENTIAL_SECRET=change_this_nodered_user_credential_secret

# Koperasi Desa — application-specific (Laravel 11)
KOPERASIDESA_DB_USER=koperasidesa_user
KOPERASIDESA_DB_PASS=change_this_koperasidesa_db_password
KOPERASIDESA_DB_NAME=db_koperasidesa
